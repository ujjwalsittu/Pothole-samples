# Base URL of the API server (no trailing slash). Defaults to http://localhost:4000
VITE_API_URL=http://localhost:4000

# ---- Auth0 (SPA application) ----
# Leave VITE_AUTH0_DOMAIN unset (or empty) to run in DEV BYPASS mode:
# the dashboard skips Auth0 entirely and sends x-dev-sub / x-dev-email
# headers, matching the API's DEV_AUTH_BYPASS mode.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=yourSpaClientId
VITE_AUTH0_AUDIENCE=https://api.potholecollect.example

# Identity used in dev-bypass mode (optional; defaults shown)
VITE_DEV_SUB=dev|admin
VITE_DEV_EMAIL=admin@dev.local
