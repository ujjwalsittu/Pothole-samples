# Server
PORT=4000

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/potholes

# Auth0 (leave empty + set DEV_AUTH_BYPASS=1 for local dev without Auth0)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
DEV_AUTH_BYPASS=

# Mail (Resend). If RESEND_API_KEY is empty, mail is logged and skipped.
RESEND_API_KEY=
MAIL_FROM=PotholeCollect <onboarding@resend.dev>
ADMIN_EMAIL=

# Media storage
# STORAGE_DRIVER=local (default) keeps media under STORAGE_DIR.
# STORAGE_DRIVER=s3 stages chunk uploads locally, then promotes finished media
# to S3 (multipart). S3_ENDPOINT enables MinIO-compatible mode (path-style).
# AWS credentials come from the standard chain (env/shared config/IMDS).
STORAGE_DIR=./uploads
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=

# Map-matching. Either point OSRM_URL at an external server, or leave it empty
# and use the managed instance (admin panel: /admin/osrm/* downloads a
# Geofabrik .osm.pbf, preprocesses it and runs osrm-routed via local binaries
# or docker). OSRM_DATA_DIR holds the map + graph files; OSRM_PORT is the
# managed server's port.
OSRM_URL=
OSRM_DATA_DIR=./osrm-data
OSRM_PORT=5001

# Video frame extraction + posters use the system `ffmpeg` binary (no npm dep).
# Install it (apt install ffmpeg) — everything degrades gracefully without it.

# Google Drive export (service account). Optional — endpoint returns 501 if unset.
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_FOLDER_ID=

# CORS (comma-separated origins; empty = allow all)
CORS_ORIGINS=

# Optional explicit ffmpeg binary (otherwise: system ffmpeg, then the bundled
# ffmpeg-static binary installed by npm on Linux x64/arm64, macOS, Windows).
# Alpine/musl containers: apk add ffmpeg, or set this path.
# FFMPEG_PATH=/usr/bin/ffmpeg
