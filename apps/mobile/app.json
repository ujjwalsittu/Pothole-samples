{
  "expo": {
    "name": "PotholeCollect",
    "slug": "pothole-collect",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "potholecollect",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1220",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0B1220"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.threemates.potholecollect",
      "infoPlist": {
        "NSCameraUsageDescription": "PotholeCollect uses the camera to capture pothole photos and videos of the road surface.",
        "NSLocationWhenInUseUsageDescription": "PotholeCollect attaches a precise GPS location to every pothole sample. Samples without an accurate, genuine location are rejected.",
        "NSMicrophoneUsageDescription": "The microphone is used while recording pothole videos."
      }
    },
    "android": {
      "package": "com.threemates.potholecollect",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1220"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "PotholeCollect uses the camera to capture pothole photos and videos of the road surface.",
          "microphonePermission": "The microphone is used while recording pothole videos.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PotholeCollect attaches a precise GPS location to every pothole sample. Samples without an accurate, genuine location are rejected."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "The microphone is used while recording pothole videos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F59E0B"
        }
      ],
      [
        "react-native-auth0",
        {
          "domain": "tmv.jp.auth0.com",
          "customScheme": "potholecollect"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://api-potholes.threemates.in/api/v1",
      "auth0Domain": "tmv.jp.auth0.com",
      "auth0ClientId": "qDn3qug1tBxuBDKdAjJhJxBGl60MQhQ4",
      "auth0Audience": "https://api-potholes.threemates.in",
      "auth0Scheme": "potholecollect",
      "devAuthBypass": false,
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "15f90876-5a0c-491b-8faf-4480d067453c"
      }
    },
    "owner": "ujjwal-tmv"
  }
}
